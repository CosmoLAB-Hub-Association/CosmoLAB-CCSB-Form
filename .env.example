# Firebase (client / web config)
# Note: pour une app Firebase côté navigateur, ces valeurs ne sont pas des "secrets" au sens strict,
# mais évite quand même de les commiter si tu ne veux pas les exposer publiquement.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:123:web:abc"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
# Optionnel
VITE_FIREBASE_MEASUREMENT_ID=""
# Optionnel: si tu utilises un databaseId Firestore non-default
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# (Optionnel) Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
